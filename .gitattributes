# Normalise line endings so the shell scripts keep working on Windows while
# source files stay stable across platforms.
* text=auto

# Shell and Python scripts must keep LF.
*.sh            text eol=lf
*.py            text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf

# Windows-centric project files.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.sln           text eol=crlf
*.vcxproj       text eol=crlf

# Binary assets.
*.dfm           binary
*.res           binary
*.png           binary
*.ico           binary
*.zip           binary

# Exclude generated files from language statistics on GitHub.
build/**        linguist-vendored
*.ts            linguist-detectable
