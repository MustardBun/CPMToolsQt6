{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/qt",
                "${workspaceFolder}/build/_deps/**",
                "D:/msys64/ucrt64/include/**",
                "D:/msys64/ucrt64/include/qt6/**",
                "D:/msys64/ucrt64/include/qt6/QtCore",
                "D:/msys64/ucrt64/include/qt6/QtGui",
                "D:/msys64/ucrt64/include/qt6/QtWidgets"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "D:/msys64/ucrt64/bin/g++.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ]
}
